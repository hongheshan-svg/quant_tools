{
  "name": "quant-tools-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "A股量化交易系统桌面端（Electron）",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.quanttools.desktop",
    "productName": "AStockQuant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hongheshan-svg",
        "repo": "quant_tools"
      }
    ],
    "extraResources": [
      {
        "from": "../../dist/backend/quant_server",
        "to": "backend/quant_server"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "AStockQuant-${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "A股量化"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "artifactName": "AStockQuant-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "AStockQuant-${version}-linux-${arch}.${ext}",
      "category": "Finance"
    },
    "afterPack": "scripts/afterPackMacos.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
