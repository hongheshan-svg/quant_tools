# ============================================================
# A股舆情驱动量化交易系统 - 全局配置
# ============================================================
# 使用方法: 复制本文件为 settings.yaml，填入您的 API Key

# --- LLM API 配置 ---
# 支持平台: deepseek / qwen(通义千问) / zhipu(智谱GLM) / moonshot(Kimi)
#            baidu(文心一言) / siliconflow(硅基流动) / openai / custom(自定义)
# 提示: 可在程序界面点击【AI设置】按钮切换平台，无需手动编辑此文件
llm:
  # 主力模型（在界面中可自由切换）
  primary:
    provider: deepseek
    api_key: "your-deepseek-api-key-here"
    base_url: "https://api.deepseek.com"
    model: "deepseek-chat"
    max_tokens: 4096
    temperature: 0.3
  # 备用模型（主力模型失败时自动切换）
  backup:
    provider: openai
    api_key: "your-openai-api-key-here"
    base_url: "https://api.openai.com/v1"
    model: "gpt-4o"
    max_tokens: 4096
    temperature: 0.3
  # 调用方式：litellm（默认，支持 Claude、Gemini、Ollama 本地模型和所有 OpenAI 兼容平台）/ openai（OpenAI SDK 直连）
  backend: litellm
  # 自定义单价（美元/百万 token，[输入, 输出]），用于用量页估算费用；不填时用 LiteLLM 自带的价格表
  # pricing:
  #   deepseek-chat: [0.27, 1.1]
  pricing: {}
  # ---- 以下为各平台 base_url 参考 ----
  # DeepSeek:      https://api.deepseek.com
  # 通义千问:      https://dashscope.aliyuncs.com/compatible-mode/v1
  # 智谱GLM:       https://open.bigmodel.cn/api/paas/v4
  # 月之暗面Kimi:  https://api.moonshot.cn/v1
  # 百度文心:      https://qianfan.baidubce.com/v2
  # 豆包Doubao:    https://ark.cn-beijing.volces.com/api/v3
  # 硅基流动:      https://api.siliconflow.cn/v1
  # OpenAI:        https://api.openai.com/v1
  # Claude:        provider: anthropic，base_url 留空，model 如 claude-opus-5-5
  # Gemini:        provider: gemini，base_url 留空
  # Ollama 本地:   provider: ollama，base_url: http://localhost:11434，api_key 可留空
  # LLM 性能优化参数
  timeout_seconds: 45
  max_retries: 2
  retry_backoff_seconds: 1.5
  batch_workers: 3
  analysis_workers: 3
  cache_enabled: true
  cache_ttl_seconds: 3600
  cache_path: "data/llm_cache.sqlite3"

# --- 数据库配置 ---
database:
  sqlite_path: "data/quant.db"
  echo: false  # 是否打印SQL

# --- Redis 缓存配置 ---
redis:
  host: "127.0.0.1"
  port: 6379
  db: 0
  password: ""
  enabled: false  # 首次启动可关闭Redis

# --- 数据采集调度配置 ---
scheduler:
  # 热搜采集间隔（分钟）
  hot_search_interval: 30
  # 财联社采集间隔（分钟）
  cailianshe_interval: 5
  # 行情数据采集间隔（分钟，交易时间内）
  stock_data_interval: 15
  # 研报采集间隔（分钟）
  research_interval: 60
  # 每日分析运行时间 (HH:MM)
  daily_analysis_time: "15:30"
  # 每日信号生成时间 (HH:MM)
  daily_signal_time: "16:00"
  # 每日自学习运行时间 (HH:MM)
  self_learning_time: "16:20"
  # 每日报告推送时间 (HH:MM)，需在 notifier 中启用至少一个渠道
  daily_report_time: "16:10"
  # 自选股决策仪表盘（逐只 AI 诊断后推送，见 watchlist）
  watchlist_report_time: "16:30"

# --- 交易时间配置 ---
trading:
  # 交易日（自动从AKShare获取，此处为备用）
  morning_start: "09:30"
  morning_end: "11:30"
  afternoon_start: "13:00"
  afternoon_end: "15:00"
  # 集合竞价时间
  auction_start: "09:15"
  auction_end: "09:25"
  # 交易执行（模拟盘）
  # 生成交易信号后（定时任务 16:00、桌面端 AI涨停预测后）自动把买入信号转为待确认订单
  execution_enabled: true
  # 自动确认下单；false 时需在桌面端【模拟交易】页手动确认（仅对模拟盘生效）
  auto_confirm: false
  # 单笔订单预算（元），按信号强度缩放后取整到 100 股
  default_order_budget: 100000
  # 每次最多生成的订单数
  max_orders_per_run: 10
  # 模拟盘初始资金（元）
  paper_initial_cash: 1000000
  # 仅在交易时段内允许下单（信号在收盘后生成，开启后需在次日盘中确认）
  strict_session_check: false
  # 按大盘环境（进攻/均衡/防守/冰点）调整新开仓预算，系数见 risk.market_regime_position
  regime_position_control: true

# --- 策略权重配置 ---
strategy:
  # AI 研判：定时任务生成评分信号后，由 LLM 对 Top 股票给出 买入/观望/回避，观望和回避的信号不生成订单
  ai_advisor_enabled: true
  weights:
    sentiment_score: 0.25   # 舆情评分权重
    limit_up_score: 0.15    # 连板高度权重
    seal_strength: 0.15     # 封单强度权重
    sector_effect: 0.12     # 板块效应权重
    capital_flow: 0.10      # 资金流向权重
    technical: 0.08         # 技术面权重
    market_emotion: 0.05    # 市场情绪权重
    global_score: 0.10      # 国际因子权重（美股财报+国际事件）
  # 自学习参数（会根据历史结果自动生成 adaptive_weights 和 source_confidence）
  learning:
    enabled: true
    lookback_days: 20
    min_samples: 40
    blend_ratio: 0.35
    corr_adjust_cap: 0.25
    source_min_samples: 3
    source_conf_floor: 0.80
    source_conf_ceil: 1.20
  # 运行后会自动回写（首次可留空）
  adaptive_weights: {}
  source_confidence: {}
  # 选股数量
  top_n: 10

# --- 风险控制配置 ---
risk:
  # 单只股票最大仓位比例
  max_position_pct: 0.20
  # 单日最大买入比例
  max_daily_buy_pct: 0.50
  # 止损比例（负数）
  stop_loss_pct: -0.05
  # 止盈比例
  take_profit_pct: 0.15
  # 大盘跌幅熔断阈值
  market_circuit_breaker_pct: -0.02
  # 连续止损次数限制
  max_consecutive_losses: 3
  # 大盘环境对应的新开仓仓位系数（冰点为 0 表示暂停新开仓）
  market_regime_position:
    进攻: 1.0
    均衡: 0.6
    防守: 0.3
    冰点: 0.0
  # 黑名单关键词（过滤ST等）
  blacklist_keywords:
    - "ST"
    - "*ST"

# --- 国际数据采集配置 ---
global_data:
  # 重点跟踪的美股公司（财报）
  us_focus_stocks:
    - symbol: "NVDA"
      name: "英伟达"
      a_share_sectors: ["AI算力", "GPU", "光模块"]
    - symbol: "AAPL"
      name: "苹果"
      a_share_sectors: ["苹果产业链"]
    - symbol: "TSLA"
      name: "特斯拉"
      a_share_sectors: ["新能源车产业链"]
    - symbol: "AMD"
      name: "AMD"
      a_share_sectors: ["AI算力", "芯片"]
    - symbol: "MSFT"
      name: "微软"
      a_share_sectors: ["AI应用", "云计算"]
    - symbol: "GOOGL"
      name: "谷歌"
      a_share_sectors: ["AI应用", "数据中心"]
    - symbol: "AMZN"
      name: "亚马逊"
      a_share_sectors: ["跨境电商", "云计算"]
    - symbol: "META"
      name: "Meta"
      a_share_sectors: ["VR/AR", "AI应用"]
  # 美股数据采集频率（分钟）
  us_earnings_interval: 60
  # 国际新闻采集频率（分钟）
  global_news_interval: 30
  # 开盘前重点采集时间
  pre_market_collection_time: "08:00"

# --- 消息推送配置 ---
notifier:
  # 每日报告：定时任务在 scheduler.daily_report_time 推送，桌面端 AI涨停预测完成后也会推送
  # 内容：大盘复盘、交易信号（含价格计划）、待确认订单、模拟盘账户、近 60 天信号绩效
  daily_report_enabled: true
  # 免打扰时段（如 ["22:00", "08:00"]，可跨午夜），期间只推送紧急提醒；为空表示不启用
  quiet_hours: []
  # 企业微信
  wechat:
    enabled: false
    webhook_url: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key"
  # 钉钉
  dingtalk:
    enabled: false
    webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=your-token"
    secret: "your-secret"
  # 飞书自定义机器人（安全设置选「签名校验」时填写 secret）
  feishu:
    enabled: false
    webhook_url: "https://open.feishu.cn/open-apis/bot/v2/hook/your-hook"
    secret: ""
  # 邮件（SMTP）：QQ/163 邮箱需要在邮箱设置里开启 SMTP 并使用授权码作为 password
  email:
    enabled: false
    smtp_host: "smtp.qq.com"
    smtp_port: 465
    use_ssl: true            # 465 端口用 SSL；587 端口改为 false（使用 STARTTLS）
    username: ""
    password: ""
    sender: ""               # 为空时使用 username
    to: []                   # 收件人，如 ["me@example.com"]
  # Telegram：@BotFather 创建机器人拿 bot_token；chat_id 可给机器人发消息后访问 getUpdates 查看
  telegram:
    enabled: false
    bot_token: ""
    chat_id: ""
    api_base: "https://api.telegram.org"   # 国内网络可填自己的反向代理地址
    message_thread_id: ""                  # 超级群组的话题 ID，可空
  # Discord：频道设置 → 集成 → Webhooks → 新建 Webhook 并复制地址
  discord:
    enabled: false
    webhook_url: ""
  # Slack：api.slack.com/apps 创建应用并启用 Incoming Webhooks，复制 Webhook 地址
  slack:
    enabled: false
    webhook_url: ""
  # PushPlus：pushplus.plus 微信扫码登录后在「个人中心」获取 token；topic 填群组编码可一对多推送
  pushplus:
    enabled: false
    token: ""
    topic: ""
  # Server酱：sct.ftqq.com 获取 SendKey（Turbo 版 SCT 开头，Server酱³ 为 sctp{数字}t 开头）
  serverchan:
    enabled: false
    sendkey: ""
  # ntfy：ntfy.sh 或自建服务，订阅一个不易猜的主题；私有主题填 token
  ntfy:
    enabled: false
    server: "https://ntfy.sh"
    topic: ""
    token: ""
  # Gotify：自建服务，在「应用」里创建应用获取 token
  gotify:
    enabled: false
    server: ""               # 如 https://gotify.example.com
    token: ""
    priority: 5
  # Pushover：pushover.net 的 User Key，再在 Your Applications 里创建应用获取 API Token
  pushover:
    enabled: false
    user_key: ""
    api_token: ""
  # Bark（iOS）：App 内查看 device_key；自建服务时修改 server
  bark:
    enabled: false
    server: "https://api.day.app"
    device_key: ""
    group: ""
  # 自定义 Webhook：body_template 可用 $title $content（原文）和 $title_json $content_json（JSON 字符串，已带引号）
  # 例：body_template: '{"msgtype": "text", "text": $content_json}'；为空时发送 {"title": ..., "content": ...}
  webhook:
    enabled: false
    url: ""
    method: "POST"
    headers: ""              # JSON 文本，如 {"Authorization": "Bearer xxx"}
    body_template: ""
  # 按消息类型指定推送渠道（渠道名见上面各段，如 wechat、telegram），不写或为空的类型推送到全部已启用渠道
  # 桌面端【推送设置】可以直接修改、检查配置和发送测试消息
  routes:
    daily_report: []         # 每日报告
    alert: []                # 盘中提醒
    watchlist: []            # 自选股决策仪表盘
    chat: []                 # AI 问股

# --- 全市场策略选股 ---
# 每日分析后（及 AI涨停预测的盘前/盘后时段）按规则扫描全市场，结果作为 AI 涨停预测的候选来源之一
# 股票池过滤沿用 config/stock_pool.yaml；依赖日线历史，首次使用先运行 python scripts/fetch_history.py --mode daily
# 内置策略：volume_breakout 放量突破、strong_close 强势未板、dragon_pullback 龙回头、theme_follow 主线补涨、
#           trend_pullback 缩量回踩、oversold_rebound 超跌反弹；按大盘环境标注是否适配（适配的排在前面）
# 数据源顺序：前一个失败或没有数据才用下一个（参考 daily_stock_analysis 的多数据源）
data_sources:
  # 日线回补：tencent 腾讯、sina 新浪、eastmoney 东方财富、baostock、pytdx 通达信（不复权）、efinance（东方财富接口）、tushare（需要 token，不复权）
  daily_history: [tencent, sina, eastmoney, baostock, pytdx, efinance, tushare]
  # 实时行情：tencent、eastmoney、sina、efinance、pytdx
  realtime: [tencent, eastmoney, sina, efinance, pytdx]
  tushare_token: ""       # Tushare Pro 的 token，填写后 tushare 才可用
  pytdx_servers: []       # 自定义通达信行情服务器，如 ["117.34.114.17:7709"]；为空用内置列表

# 联网新闻搜索：个股诊断和 AI 问股（web_search 工具）用它补充最新消息。按 providers 顺序依次尝试，失败或无结果换下一个
# 每个 provider 的 api_keys 可填多个（一行一个 Key），轮换使用；某个 Key 被拒绝或限流会冷却 10 分钟
# 也可用环境变量 QUANT__SEARCH__BOCHA__API_KEYS=key1,key2 覆盖（逗号分隔）
search:
  enabled: false
  providers: [bocha, tavily, serpapi, brave, searxng]
  max_results: 8          # 每次搜索最多返回条数
  days: 7                 # 只保留最近多少天的结果（日期未知的保留）
  cache_minutes: 30       # 相同搜索词的缓存时间
  bocha:                  # 博查 https://open.bochaai.com ，中文新闻效果好，推荐首选
    api_keys: []
  tavily:                 # https://tavily.com ，每月有免费额度
    api_keys: []
  serpapi:                # https://serpapi.com ，Google 新闻搜索
    api_keys: []
  brave:                  # https://brave.com/search/api ，Brave 新闻搜索
    api_keys: []
  searxng:                # 自建 SearXNG（需在 settings.yml 的 search.formats 里开启 json），填实例地址，如 http://127.0.0.1:8080
    base_urls: []
    timeout: 10

# 聊天机器人：在钉钉、飞书里发「诊断 茅台」「大盘」「自选」「持仓」或直接提问（AI 问股），只读，不能下单。
# 用长连接收消息，不需要公网 IP；随 main.py 或 server.py（桌面端）运行，修改后重启生效
bot:
  dingtalk:
    # 钉钉开放平台 → 企业内部应用 → 机器人，消息接收模式选「Stream 模式」
    enabled: false
    client_id: ""       # AppKey
    client_secret: ""   # AppSecret
  feishu:
    # 飞书开放平台 → 企业自建应用 → 机器人，事件订阅选「长连接」并订阅 im.message.receive_v1
    enabled: false
    app_id: ""
    app_secret: ""
    domain: feishu      # 海外版 Lark 填 lark
  # 允许使用的用户 ID（钉钉 senderStaffId、飞书 open_id）；为空不限制。无权限的用户发消息时会收到自己的 ID
  allowed_users: []
  workers: 2            # 同时处理的消息数

screening:
  enabled: true
  max_per_strategy: 10   # 每个策略最多入选数量
  max_total: 30          # 合并后最多保留数量
  # 策略权重：按最近一次历史回测中各策略的次日表现，温和调整选股排序（0.8~1.2；回测超过 30 天后不再使用）
  adaptive_strategy_weights: true
  backtest_interval_days: 7   # 每日分析时距上次回测超过该天数就重新回测，0 表示不自动回测
  backtest_days: 60           # 自动回测的区间（自然日）
  # 覆盖策略参数或关闭策略，例如：
  # strategies:
  #   volume_breakout: {vol_ratio_min: 2.5, amount_min: 200000000}
  #   oversold_rebound: {enabled: false}
  strategies: {}

# --- 个股 AI 诊断 ---
diagnosis:
  # single：一次 LLM 调用；standard：技术面、情报两位分析员先各自分析，再由决策员综合（3 次调用）；
  # full：再加风险分析员（4 次调用）。分析员有分歧时信心最高为「中」
  mode: standard
  # 把近 90 天诊断的事后准确率写进提示词；看多诊断 3 日准确率低于 45%（至少 10 次）时下调买入信心
  calibration: true

# --- 自选股 ---
# 在桌面端【自选股】页增删、批量导入（粘贴文本或 CSV/Excel）；盘中提醒也会关注自选股
watchlist:
  daily_report: true       # 收盘后（scheduler.watchlist_report_time）逐只 AI 诊断，推送决策仪表盘
  max_stocks: 50           # 自选股上限（每只每天一次 LLM 调用）
  workers: 3               # 同时诊断的股票数

# --- LLM 大盘复盘 ---
# 按趋势结构、资金情绪、主线板块复盘，给出次日姿态（不会比量化大盘环境更激进）、仓位、关注与回避方向
# 定时任务在每日报告推送前生成并写进日报；桌面端「大盘复盘」页可手动生成
market_review:
  enabled: true

# --- 盘中提醒 ---
# 交易时段内每次采集行情后检查：今日信号股、模拟盘持仓、自选股，以及下面 watchlist 中的股票
# 内置提醒：封涨停、炸板、持仓跌破止损（紧急）、达到目标价、大跌；推送渠道见 notifier
alerts:
  enabled: true
  cooldown_minutes: 30     # 同一提醒的冷却时间（封涨停每只每天只提醒一次）
  big_drop_pct: -7         # 跌幅达到该值提醒
  watchlist: []            # 额外关注的股票代码，如 ["600519", "300750"]（加引号；一般在桌面端【自选股】页添加即可）
  # 自定义规则：
  #   - {code: "600519", type: price_cross, direction: above, price: 1800}   # 价格上破/下破（above/below）
  #   - {code: "300750", type: change_pct, direction: down, change_pct: 5}  # 涨跌幅达到（up/down）
  #   - {code: "002594", type: volume_spike, multiplier: 2}                 # 成交量达到近 20 日均量的倍数
  #   - {code: "600519", type: ma_cross, period: 20, direction: above}      # 价格上穿/下穿 N 日均线（above/below）
  #   - {code: "600519", type: macd_cross, direction: golden}               # MACD 金叉/死叉（golden/dead）
  #   - {code: "600519", type: kdj_cross, direction: golden}                # KDJ 金叉/死叉
  #   - {code: "600519", type: rsi, period: 6, direction: above, value: 80} # RSI 上穿/下穿阈值
  # 技术指标用日线计算（当天的行即最新价），本地日线不足时先联网补齐；指标交叉每条规则每天只提醒一次
  rules: []
  near_stop_pct: 2         # 持仓现价距止损价不到该百分比时提醒「接近止损」（每只每天一次）
  market_regime: true      # 大盘环境比前一交易日降档（如均衡→防守）时提醒，冰点为紧急提醒
  regime_score_drop: 15    # 大盘评分比前一交易日下降该分数以上时提醒

# --- 模拟盘组合风险（【模拟交易】页） ---
portfolio_risk:
  single_max_pct: 30       # 单只持仓占总资产上限（%）
  sector_max_pct: 50       # 同一行业合计占总资产上限（%，行业取最近一次涨停时的所属行业）
  near_stop_pct: 3         # 距止损价不足该百分比时提示

# --- Web / API 服务（python server.py，Electron 桌面端也用它） ---
web:
  host: "127.0.0.1"        # 改成 0.0.0.0 可让手机等局域网设备访问（必须同时开启登录）
  port: 8000
  auth_enabled: false      # 开启后需要登录；第一次登录时设置的密码保存在 data/web_auth.json
  session_days: 7          # 登录有效天数
  api_token: ""            # 给机器人、脚本用的 Bearer Token，留空不启用
  scheduler: true          # 服务同时运行定时任务（与 python main.py 二选一，避免重复采集）
  task_workers: 4          # 同时执行的后台任务数
  cors_origins: ["http://localhost:5173", "http://127.0.0.1:5173"]   # 前端开发服务器

# --- Qt6 桌面端配置 ---
desktop:
  refresh_interval_seconds: 30
  news_refresh_seconds: 10          # 资讯流独立刷新间隔（秒）
  auto_collect_enabled: true
  collect_interval_seconds: 120
  news_workers: 3
  market_workers: 4
  analysis_workers: 3
  score_workers: 4
  enable_realtime_ai: true
  realtime_ai_workers: 2
  max_log_lines: 800

# --- 日志配置 ---
logging:
  level: "INFO"
  rotation: "10 MB"
  retention: "30 days"
  log_dir: "logs"
